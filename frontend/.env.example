# Keel web app. Copy to frontend/.env.local. Next reads KEEL_API_URL at build time (rewrites), so
# rebuild after changing it. The browser only ever talks to this app; /api/* is proxied to the backend.
KEEL_API_URL=http://127.0.0.1:8000

# End-to-end tests (Playwright)
# BASE_URL=http://localhost:3000
# CHROMIUM_PATH=/path/to/chromium              # use an installed Chromium instead of Playwright's
