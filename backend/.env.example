# Copy to backend/.env. Without OPENAI_API_KEY Keel runs fully offline (local rules extractor + offline agent).
KEEL_DATABASE_URL=postgresql+psycopg://keel_app:keel_app@localhost:5432/keel
KEEL_DATABASE_OWNER_URL=postgresql+psycopg://keel_owner:keel_owner@localhost:5432/keel
KEEL_STORAGE_DIR=./var/storage
KEEL_FRONTEND_URL=http://localhost:3000
# KEEL_LLM_MODE=auto   # auto | fake | live
# OPENAI_API_KEY=       # GPT-6 Luna: default extractor and Ask Keel model
# GOOGLE_API_KEY=       # Gemini 3.8 Flash: handwriting re-reads when checks fail
# FIREWORKS_API_KEY=    # GLM-5.3: reasoning tier
