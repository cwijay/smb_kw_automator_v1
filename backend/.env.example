# Copy to backend/.env. Without OPENAI_API_KEY Keel runs fully offline (local rules extractor + offline agent).
KEEL_DATABASE_URL=postgresql+psycopg://keel_app:keel_app@localhost:5432/keel
KEEL_DATABASE_OWNER_URL=postgresql+psycopg://keel_owner:keel_owner@localhost:5432/keel
KEEL_STORAGE_DIR=./var/storage
KEEL_FRONTEND_URL=http://localhost:3000
# KEEL_LLM_MODE=auto   # auto | fake | live
# OPENAI_API_KEY=       # GPT-6 Luna: default extractor and Ask Keel model
# GOOGLE_API_KEY=       # Gemini 3.8 Flash: handwriting re-reads when checks fail
# FIREWORKS_API_KEY=    # GLM-5.3: reasoning tier

# Tier 4 (off by default): only for pages still failing checks after the Gemini re-read.
# KEEL_TIER4_ENGINE=     # reducto | ade | sol — pick per document type with `keel evals parsers`
# REDUCTO_API_KEY=
# VISION_AGENT_API_KEY=  # LandingAI ADE

# Files: local disk by default; a Google Cloud Storage bucket in the cloud. Credentials come from the
# runtime service account (locally: `gcloud auth application-default login`); there are no storage keys.
# KEEL_STORAGE_BACKEND=gcs
# KEEL_GCS_BUCKET=

# Tracing (optional, `uv sync --extra observability`). Traces contain document text: use a Langfuse you control.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://langfuse.example.com
